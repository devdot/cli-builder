{
    "name": "devdot/cli-builder",
    "description": "Tools for development of devdot/cli.",
    "type": "project",
    "license": "MIT",
    "keywords": ["dev"],
    "autoload": {
        "psr-4": {
            "Devdot\\Cli\\Builder\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Thomas Kuschan",
            "email": "mail@thomaskuschan.de"
        }
    ],
    "bin": [
        "bin/cli-builder"
    ],
    "require": {
        "devdot/cli": "^1",
        "devdot/cli-directory-project": "^1.1",
        "nadar/php-composer-reader": "^2.0",
        "nette/php-generator": "^4.1",
        "nikic/php-parser": "^4.7|^5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12",
        "rector/rector": "^2.3",
        "squizlabs/php_codesniffer": "^4"
    },
    "scripts": {
        "check-static": "phpstan analyse",
        "format": "phpcbf --standard=PSR12 src tests",
        "test": "phpunit tests"
    },
    "config": {
        "sort-packages": true
    }
}
